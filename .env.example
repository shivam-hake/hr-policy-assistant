# Copy this file to .env and fill in your keys. Never commit .env.

# Which provider to use: groq | google_genai
LLM_PROVIDER=groq

GROQ_API_KEY=
GOOGLE_API_KEY=

# Model names change over time. Check the current lists before running:
#   Groq:   https://console.groq.com/docs/models
#   Gemini: https://ai.google.dev/gemini-api/docs/models
# "main" = accurate model for extraction; "fast" = cheaper model for simple steps.
GROQ_MAIN_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GEMINI_MAIN_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Hidden reasoning budget for GPT-OSS on Groq: low | medium | high
GROQ_REASONING_EFFORT=low
